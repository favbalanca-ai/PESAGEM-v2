{
  "manifest_version": 3,
  "name": "FAV - Emissor NFA SEFAZ-GO",
  "version": "7.5",
  "description": "Preenche automaticamente a NFA no portal SEFAZ-GO com dados do sistema de pesagem FAV.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://nfw.sefaz.go.gov.br/*",
    "https://sistemas.sefaz.go.gov.br/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://favbalanca-ai.github.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://favbalanca-ai.github.io/*"],
      "js": ["anuncio.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FAV NFA"
  }
}